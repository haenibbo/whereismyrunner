function decodeLine(b64) {
  const raw = atob(b64); let i = 0, lo = 0, la = 0; const out = [];
  const rd = () => { let z = 0, m = 1, b; do { b = raw.charCodeAt(i++); z += (b & 127) * m; m *= 128; } while (b & 128); return (z % 2) ? -(z + 1) / 2 : z / 2; };
  while (i < raw.length) { lo += rd(); la += rd(); out.push([lo / 1e5, la / 1e5]); }
  return out;
}
const pad2 = n => String(n).padStart(2, '0');
const hms = s => { s = Math.round(s); return pad2(Math.floor(s / 3600)) + ':' + pad2(Math.floor(s % 3600 / 60)) + ':' + pad2(s % 60); };
const fmtKm = km => Number.isInteger(km) ? km.toFixed(1) : String(+km.toFixed(3));
const R_EARTH = 6378137;
const toMerc = (lng, lat) => [R_EARTH * lng * Math.PI / 180, R_EARTH * Math.log(Math.tan(Math.PI / 4 + lat * Math.PI / 360))];
const fromMerc = (X, Y) => [X / R_EARTH * 180 / Math.PI, (2 * Math.atan(Math.exp(Y / R_EARTH)) - Math.PI / 2) * 180 / Math.PI];

function lineCum(line) {
  const lat0 = line.reduce((s, p) => s + p[1], 0) / line.length;
  const KX = 111320 * Math.cos(lat0 * Math.PI / 180), KY = 110540;
  const cum = [0];
  for (let i = 1; i < line.length; i++) cum.push(cum[i - 1] + Math.hypot((line[i][0] - line[i - 1][0]) * KX, (line[i][1] - line[i - 1][1]) * KY));
  return cum;
}
function positionAt(line, cum, s) {
  if (s <= 0) return line[0].slice();
  const L = cum[cum.length - 1]; if (s >= L) return line[line.length - 1].slice();
  let lo = 0, hi = cum.length - 1;
  while (hi - lo > 1) { const m = (lo + hi) >> 1; if (cum[m] <= s) lo = m; else hi = m; }
  const t = (s - cum[lo]) / ((cum[hi] - cum[lo]) || 1);
  return [line[lo][0] + (line[hi][0] - line[lo][0]) * t, line[lo][1] + (line[hi][1] - line[lo][1]) * t];
}

