<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>마라톤 코스 · 지점별 도착 시각 (v5)</title>
<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/maplibre-gl@4.7.1/dist/maplibre-gl.css">
<style>
  * { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; }
  body { font-family: "Malgun Gothic", "Apple SD Gothic Neo", sans-serif; color: #1f2937; background: #f3f4f6; overflow: hidden; }
  button { font-family: inherit; cursor: pointer; }
  svg.ic { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  #app { position: fixed; inset: 0; display: flex; }
  #mapPane { flex: 1; position: relative; min-width: 0; }
  #map { position: absolute; inset: 0; }

  /* 위쪽 설정창 */
  #topPanel { position: absolute; top: 0; left: 0; right: 0; z-index: 20; background: rgba(17,24,39,.94); color: #fff; padding: 10px 62px 10px 14px; transition: transform .25s ease, opacity .25s ease; }
  #topPanel.off { transform: translateY(-110%); opacity: 0; pointer-events: none; }
  #topPanel h1 { margin: 0 0 8px; font-size: 15px; line-height: 1.35; }
  .controls { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; }
  .controls label { display: flex; align-items: center; gap: 6px; font-size: 14px; }
  .controls input { padding: 5px 7px; border-radius: 6px; border: 1px solid #9ca3af; font-size: 15px; }
  .controls input[type=number] { width: 58px; }
  #summary { font-size: 13px; color: #fbbf24; font-weight: bold; }
  .courseRow { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; align-items: center; }
  .courseRow button { background: #2563eb; color: #fff; border: 0; border-radius: 6px; padding: 6px 10px; font-size: 13px; }
  .courseRow button.sub { background: #4b5563; }

  /* 오른쪽 위 아이콘 */
  #fab { position: absolute; top: 10px; right: 10px; z-index: 30; display: flex; flex-direction: column; gap: 8px; }
  #fab button { width: 42px; height: 42px; border-radius: 50%; border: 0; background: #fff; color: #111827; box-shadow: 0 1px 5px rgba(0,0,0,.35); display: flex; align-items: center; justify-content: center; }
  #fab button.on { background: #111827; color: #fff; }

  /* 범례 */
  #legend { position: absolute; left: 10px; bottom: 34px; z-index: 15; background: rgba(255,255,255,.95); border: 1px solid #d1d5db; border-radius: 8px; padding: 8px 10px; font-size: 12px; line-height: 1.6; box-shadow: 0 1px 4px rgba(0,0,0,.2); max-width: 190px; max-height: 50vh; overflow: auto; }
  #legend.off { display: none; }
  #legend .row { display: flex; align-items: center; gap: 6px; }
  #legend .sw { display: inline-block; width: 26px; height: 4px; border-radius: 2px; flex: none; }
  #legend .course { height: 8px; background: #e11d48; border: 1px solid #fff; box-shadow: 0 0 0 1px #e11d48; }
  #legend .stn { display: inline-block; width: 12px; height: 12px; border-radius: 50%; background: #fff; border: 3px solid #1f2937; margin: 0 7px; flex: none; }
  #legend .sep { height: 1px; background: #e5e7eb; margin: 4px 0; }

  #mapMsg { position: absolute; inset: 0; display: none; align-items: center; justify-content: center; text-align: center; padding: 24px; background: #fff; font-size: 14px; line-height: 1.7; z-index: 5; }
  #pickBanner { position: absolute; top: 10px; left: 10px; right: 64px; z-index: 40; display: none; background: #2563eb; color: #fff; border-radius: 8px; padding: 10px 12px; font-size: 14px; line-height: 1.5; box-shadow: 0 2px 8px rgba(0,0,0,.4); }
  #pickBanner button { margin-left: 8px; background: #fff; color: #2563eb; border: 0; border-radius: 6px; padding: 3px 8px; font-size: 13px; }

  /* 지도 위 시각 표시 */
  .pt { position: absolute; left: 0; top: 0; transform: translate(-50%, -100%); text-align: center; white-space: nowrap; pointer-events: auto; }
  .pt .tm { display: inline-block; background: rgba(17,24,39,.92); color: #fff; border: 1px solid #fbbf24; border-radius: 4px; padding: 1px 5px; font-size: 11px; font-weight: bold; }
  .pt .dot { display: block; width: 10px; height: 10px; margin: 2px auto -5px; border-radius: 50%; background: #f59e0b; border: 2px solid #fff; box-shadow: 0 0 2px #000; }
  .pt.first .dot { background: #16a34a; width: 14px; height: 14px; }
  .pt.last .dot { background: #dc2626; width: 14px; height: 14px; }
  .pt.hl .dot { border-color: #06b6d4; box-shadow: 0 0 0 3px #06b6d4; }
  .pt.hl .tm { background: #0e7490; }
  .low .pt:not(.major) { display: none; }
  .anchorPin { background: #2563eb; color: #fff; font-size: 12px; font-weight: bold; border: 2px solid #fff; border-radius: 50%; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; box-shadow: 0 1px 4px rgba(0,0,0,.5); }

  /* 지점 목록 */
  #sheet { width: 340px; background: #fff; border-left: 1px solid #d1d5db; display: flex; flex-direction: column; min-height: 0; }
  #sheetHandle { display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background: #111827; color: #fff; font-size: 14px; flex: none; touch-action: none; }
  #sheetHandle .bar { display: none; }
  #sheetClose { display: none; background: transparent; border: 0; color: #fff; padding: 4px 8px; }
  #sheetBody { overflow-y: auto; flex: 1; min-height: 0; overscroll-behavior: contain; }
  #sheetBtn { display: none; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { position: sticky; top: 0; background: #e5e7eb; padding: 6px; text-align: left; }
  td { padding: 5px 6px; border-bottom: 1px solid #f0f0f0; }
  tr.row { cursor: pointer; }
  tr.row:hover { background: #cffafe; }
  td.t { font-variant-numeric: tabular-nums; font-weight: bold; white-space: nowrap; }
  .note { padding: 8px 10px; font-size: 11px; color: #6b7280; line-height: 1.5; }

  @media (max-width: 800px) {
    #sheet { position: fixed; inset: 0; width: auto; z-index: 50; transform: translateY(100%); transition: transform .28s ease; border-left: 0; }
    #sheet.open { transform: none; }
    #sheetHandle { padding: 10px 12px 10px; }
    #sheetHandle .bar { display: block; position: absolute; left: 50%; top: 5px; width: 40px; height: 4px; margin-left: -20px; border-radius: 2px; background: #6b7280; }
    #sheetHandle { position: relative; }
    #sheetClose { display: block; }
    #sheetBtn { display: flex; position: fixed; left: 50%; bottom: 8px; transform: translateX(-50%); z-index: 22; width: 64px; height: 30px; border-radius: 15px; border: 0; background: rgba(17,24,39,.92); color: #fff; align-items: center; justify-content: center; box-shadow: 0 1px 5px rgba(0,0,0,.4); touch-action: none; }
    #sheetBtn.gone { display: none; }
    #legend { bottom: 48px; }
  }

  /* 코스도 올리기 */
  #wiz { position: fixed; inset: 0; z-index: 100; background: #111827; color: #fff; display: flex; flex-direction: column; }
  #wiz[hidden], #wiz.away { display: none; }
  .wizTop { display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; background: #0b1220; flex: none; }
  .wizTop b { font-size: 15px; }
  .wizTop span { font-size: 12px; color: #fbbf24; }
  .wizTop button { background: transparent; border: 0; color: #fff; font-size: 20px; padding: 0 6px; }
  #wizImgWrap { position: relative; flex: 1; min-height: 0; }
  #wizScroll { position: absolute; inset: 0; overflow: auto; background: #000; }
  #wizCanvas { display: block; }
  #wizZoom { position: absolute; right: 8px; top: 8px; display: flex; flex-direction: column; gap: 6px; }
  #wizZoom button { width: 38px; height: 38px; border-radius: 8px; border: 0; background: rgba(255,255,255,.92); color: #111827; font-size: 20px; font-weight: bold; }
  #wizPanel { flex: none; background: #1f2937; padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); max-height: 46vh; overflow-y: auto; font-size: 13px; line-height: 1.55; }
  #wizPanel .hint { color: #d1d5db; margin-bottom: 8px; }
  #wizMsg { color: #fca5a5; min-height: 18px; margin: 4px 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 6px 0; }
  .chip { display: inline-flex; align-items: center; gap: 6px; background: #374151; border-radius: 14px; padding: 3px 8px; }
  .chip i { width: 14px; height: 14px; border-radius: 50%; border: 1px solid #fff; display: inline-block; }
  .chip button { background: transparent; border: 0; color: #fff; padding: 0 2px; }
  .btn { background: #2563eb; color: #fff; border: 0; border-radius: 6px; padding: 7px 12px; font-size: 13px; }
  .btn.gray { background: #4b5563; }
  .btn:disabled { opacity: .4; cursor: default; }
  .seg { display: flex; gap: 6px; margin: 6px 0; }
  .seg button { flex: 1; background: #374151; color: #fff; border: 2px solid transparent; border-radius: 6px; padding: 7px 4px; font-size: 13px; }
  .seg button.on { border-color: #fbbf24; background: #4b5563; }
  .anchorRow { display: flex; align-items: center; gap: 6px; margin: 6px 0; flex-wrap: wrap; }
  .anchorRow b { width: 64px; }
  .ok { color: #86efac; }
  .navRow { display: flex; justify-content: space-between; gap: 8px; margin-top: 10px; }
  #wizPanel input[type=number], #wizPanel select { padding: 5px 7px; border-radius: 6px; border: 1px solid #9ca3af; font-size: 14px; }
  #wizPanel input[type=range] { width: 100%; }
</style>
<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
