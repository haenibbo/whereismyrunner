</head>
<body>
<div id="app">
  <div id="mapPane">
    <div id="map"></div>

    <div id="topPanel">
      <h1 id="title"></h1>
      <div class="controls">
        <label>출발 시각 <input type="time" id="start" value="07:30"></label>
        <label>페이스(1km당)
          <input type="number" id="pm" min="2" max="15" value="5"> 분
          <input type="number" id="ps" min="0" max="59" value="30"> 초
        </label>
        <span id="summary"></span>
      </div>
      <div class="courseRow">
        <button id="btnUpload" type="button">코스도 올리기</button>
        <button id="btnDefault" class="sub" type="button" hidden>JTBC 기본 코스로 되돌리기</button>
      </div>
    </div>

    <div id="fab">
      <button id="fabSettings" type="button" class="on" title="설정 보기/숨기기" aria-label="설정">
        <svg class="ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
      </button>
      <button id="fabLegend" type="button" class="on" title="범례 보기/숨기기" aria-label="범례">
        <svg class="ic" viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13"/><circle cx="3.5" cy="6" r="1"/><circle cx="3.5" cy="12" r="1"/><circle cx="3.5" cy="18" r="1"/></svg>
      </button>
    </div>

    <div id="legend"></div>
    <div id="pickBanner"><span id="pickText"></span><button id="pickCancel" type="button">취소</button></div>
    <div id="mapMsg"></div>
  </div>

  <aside id="sheet">
    <div id="sheetHandle">
      <span class="bar"></span>
      <b>지점별 도착 시각</b>
      <button id="sheetClose" type="button" title="목록 숨기기" aria-label="목록 숨기기">
        <svg class="ic" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
      </button>
    </div>
    <div id="sheetBody">
      <table>
        <thead><tr><th>km</th><th>지점</th><th>도착 시각</th></tr></thead>
        <tbody id="rows"></tbody>
      </table>
      <div class="note" id="noteBox"></div>
    </div>
  </aside>
  <button id="sheetBtn" type="button" title="지점 목록 보기" aria-label="지점 목록 보기">
    <svg class="ic" viewBox="0 0 24 24"><path d="M6 15l6-6 6 6"/></svg>
  </button>
</div>

<!-- 코스도 올리기 화면 -->
<div id="wiz" hidden>
  <div class="wizTop"><b>코스도 올리기</b><span id="wizStep"></span><button id="wizClose" type="button" aria-label="닫기">✕</button></div>
  <div id="wizImgWrap">
    <div id="wizScroll"><canvas id="wizCanvas"></canvas></div>
    <div id="wizZoom"><button id="zIn" type="button">＋</button><button id="zOut" type="button">－</button></div>
  </div>
  <div id="wizPanel"></div>
</div>
<input type="file" id="fileIn" accept="image/*" hidden>

