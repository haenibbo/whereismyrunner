  const n = A.length, wm = [w.reduce((s, v) => s + v[0], 0) / n, w.reduce((s, v) => s + v[1], 0) / n], zm = [z.reduce((s, v) => s + v[0], 0) / n, z.reduce((s, v) => s + v[1], 0) / n];
  let nr = 0, ni = 0, den = 0;
  for (let i = 0; i < n; i++) { const wr = w[i][0] - wm[0], wi = w[i][1] - wm[1], zr = z[i][0] - zm[0], zi = z[i][1] - zm[1]; nr += wr * zr + wi * zi; ni += wr * zi - wi * zr; den += wr * wr + wi * wi; }
  if (den === 0) return null;
  let ar = nr / den, ai = ni / den; const rot = Math.atan2(ai, ar) * 180 / Math.PI;
  if (Math.abs(rot) < 3) { ar = nr / den; ai = 0; }
  const br = zm[0] - (ar * wm[0] - ai * wm[1]), bi = zm[1] - (ar * wm[1] + ai * wm[0]);
  const f = (px, py) => { const wr = px, wi = -py; return fromMerc(ar * wr - ai * wi + br, ar * wi + ai * wr + bi); };
  let maxRes = 0;
  A.forEach(a => { const p = f(a.px, a.py); const e = toMerc(p[0], p[1]); const t = toMerc(a.ll[0], a.ll[1]); maxRes = Math.max(maxRes, Math.hypot(e[0] - t[0], e[1] - t[1]) * Math.cos(a.ll[1] * Math.PI / 180)); });
  return { f: f, rot: Math.abs(rot) < 3 ? 0 : rot, mPerPx: Math.hypot(ar, ai) * Math.cos(A[0].ll[1] * Math.PI / 180), maxRes: maxRes };
}

// ----- 화면 그리기 -----
function wzDraw() {
  const cv = $('wizCanvas'), { W, H } = WZ; cv.width = W; cv.height = H;
  cv.style.width = Math.round(W * WZ.scale) + 'px'; cv.style.height = Math.round(H * WZ.scale) + 'px';
  const cx = cv.getContext('2d'); cx.drawImage(WZ.base, 0, 0);
  if (WZ.step === 1 && WZ.showMask && WZ.maskCanvas) cx.drawImage(WZ.maskCanvas, 0, 0);
  const u = 1 / WZ.scale;
  if (WZ.step >= 3 && WZ.path) { cx.strokeStyle = '#22d3ee'; cx.lineWidth = 3 * u; cx.lineJoin = 'round'; cx.beginPath(); WZ.path.forEach((p, i) => i ? cx.lineTo(p[0], p[1]) : cx.moveTo(p[0], p[1])); cx.stroke(); }
  if (WZ.step >= 2) WZ.pts.forEach((p, i) => {
    cx.fillStyle = p.type === 'start' ? '#16a34a' : p.type === 'end' ? '#dc2626' : '#f59e0b'; cx.strokeStyle = '#fff'; cx.lineWidth = 2 * u;
    cx.beginPath(); cx.arc(p.x, p.y, 9 * u, 0, 7); cx.fill(); cx.stroke();
    cx.fillStyle = '#fff'; cx.font = 'bold ' + 11 * u + 'px sans-serif'; cx.textAlign = 'center'; cx.textBaseline = 'middle'; cx.fillText(String(i + 1), p.x, p.y + 0.5 * u);
  });
  if (WZ.step === 3) WZ.anchors.forEach((a, i) => {
    if (a.px === undefined) return; cx.fillStyle = '#2563eb'; cx.strokeStyle = '#fff'; cx.lineWidth = 2 * u;
    cx.fillRect(a.px - 9 * u, a.py - 9 * u, 18 * u, 18 * u); cx.strokeRect(a.px - 9 * u, a.py - 9 * u, 18 * u, 18 * u);
    cx.fillStyle = '#fff'; cx.font = 'bold ' + 12 * u + 'px sans-serif'; cx.textAlign = 'center'; cx.textBaseline = 'middle'; cx.fillText('A' + (i + 1), a.px, a.py + 0.5 * u);
  });
}
$('wizCanvas').addEventListener('click', e => {
  const rect = $('wizCanvas').getBoundingClientRect(); const x = (e.clientX - rect.left) * WZ.W / rect.width, y = (e.clientY - rect.top) * WZ.H / rect.height;
  wzTap(x, y);
});
function wzTap(x, y) {
  WZ.msg = '';
  if (WZ.step === 1) {
    const c = wzPickColor(Math.round(x), Math.round(y)); if (c) { WZ.colors.push(c); wzComputeMask(); }
  } else if (WZ.step === 2) {
    const type = WZ.mode; if (type === 'start') WZ.pts = WZ.pts.filter(p => p.type !== 'start'); if (type === 'end') WZ.pts = WZ.pts.filter(p => p.type !== 'end');
    const p = { x: x, y: y, type: type };
    if (type === 'start') WZ.pts.unshift(p); else if (type === 'end') WZ.pts.push(p);
    else { const ei = WZ.pts.findIndex(q => q.type === 'end'); if (ei >= 0) WZ.pts.splice(ei, 0, p); else WZ.pts.push(p); }
    if (type === 'start') WZ.mode = 'mid'; WZ.path = null;
  } else if (WZ.step === 3 && WZ.imgPick >= 0) {
    const a = WZ.anchors[WZ.imgPick]; a.px = x; a.py = y; WZ.imgPick = -1;
  }
  wzRender();
}

// ----- 단계별 패널 -----
function wzRender() {
  const P = $('wizPanel'), s = WZ.step;
  $('wizStep').textContent = s + ' / 4 단계';
  let h = '';
  if (s === 1) {
    h += '<div class="hint"><b>① 코스선 색 알려주기</b><br>이미지에서 <b>코스선 위</b>를 눌러 주세요. 코스선이 여러 색(오르막/내리막 등)이면 색마다 한 번씩 눌러 주세요. 분홍색으로 덮인 부분이 코스선으로 인식된 곳입니다.</div>';
    h += '<div class="chips">' + WZ.colors.map((c, i) => '<span class="chip"><i style="background:rgb(' + c.join(',') + ')"></i>색 ' + (i + 1) + '<button type="button" data-rm="' + i + '">✕</button></span>').join('') + '</div>';
    h += '<label>색 허용 범위 <b id="tolV">' + WZ.tol + '</b><input type="range" id="tol" min="20" max="140" value="' + WZ.tol + '"></label>';
    h += '<label><input type="checkbox" id="showMask"' + (WZ.showMask ? ' checked' : '') + '> 인식된 부분 보기</label>';
  } else if (s === 2) {
    h += '<div class="hint"><b>② 시작·경유·도착 찍기</b><br>코스선 위를 달리는 순서대로 눌러 주세요. 같은 길을 갔다가 돌아오는 코스는 <b>반환점</b>을 경유점으로 꼭 찍어 주세요.</div>';
    h += '<div class="seg"><button type="button" data-mode="start" class="' + (WZ.mode === 'start' ? 'on' : '') + '">시작점</button><button type="button" data-mode="mid" class="' + (WZ.mode === 'mid' ? 'on' : '') + '">경유점</button><button type="button" data-mode="end" class="' + (WZ.mode === 'end' ? 'on' : '') + '">도착점</button></div>';
    h += '<div class="chips">' + WZ.pts.map((p, i) => '<span class="chip">' + (i + 1) + '. ' + (p.type === 'start' ? '시작' : p.type === 'end' ? '도착' : '경유') + '<button type="button" data-rmp="' + i + '">✕</button></span>').join('') + '</div>';
  } else if (s === 3) {
    h += '<div class="hint"><b>③ 지도와 위치 맞추기</b><br>이미지와 지도에서 <b>똑같이 알아볼 수 있는 장소(지하철역·큰 교차로 등)</b>를 서로 멀리 떨어진 2곳 이상 골라 주세요. 각 기준점마다 [이미지에서 선택] → [지도에서 선택] 순서로 누릅니다. 하늘색 선은 읽어 낸 코스선입니다.</div>';
    WZ.anchors.forEach((a, i) => {
      h += '<div class="anchorRow"><b>기준점 ' + (i + 1) + '</b><button type="button" class="btn gray" data-aimg="' + i + '">이미지에서 선택' + (a.px !== undefined ? ' ✓' : '') + '</button>' +
        '<button type="button" class="btn gray" data-amap="' + i + '"' + (a.px === undefined ? ' disabled' : '') + '>지도에서 선택' + (a.ll ? ' ✓' : '') + '</button></div>';
    });
    if (WZ.anchors.length < 4) h += '<button type="button" class="btn gray" id="addAnchor">기준점 추가</button>';
    if (WZ.imgPick >= 0) h += '<div class="ok">이미지에서 기준점 ' + (WZ.imgPick + 1) + '의 위치를 눌러 주세요.</div>';
    const T = wzFitTransform(WZ.anchors); if (T) h += '<div class="ok">위치 맞추기 완료 (이미지 1픽셀 ≈ ' + T.mPerPx.toFixed(1) + 'm' + (WZ.anchors.filter(a => a.ll).length >= 3 ? ', 기준점 오차 최대 ' + Math.round(T.maxRes) + 'm' : '') + ')</div>';
  } else {
    h += '<div class="hint"><b>④ 코스 거리 정하고 적용하기</b><br>이 코스의 실제 총 거리를 골라 주세요. 읽어 낸 코스선 길이를 이 거리에 맞춰 1km마다 도착 시각 지점을 만듭니다.</div>';
    const presets = [['42.195', '풀코스 42.195km'], ['21.0975', '하프 21.0975km'], ['10', '10km'], ['5', '5km']];
    const isPreset = presets.some(p => Number(p[0]) === WZ.total);
    h += '<select id="preset">' + presets.map(p => '<option value="' + p[0] + '"' + (Number(p[0]) === WZ.total ? ' selected' : '') + '>' + p[1] + '</option>').join('') + '<option value="custom"' + (isPreset ? '' : ' selected') + '>직접 입력</option></select> ';
    h += '<input type="number" id="totalIn" step="0.001" min="1" max="200" value="' + WZ.total + '" style="width:90px"> km';
  }
  h += '<div id="wizMsg">' + (WZ.msg || '') + '</div>';
  h += '<div class="navRow"><button type="button" class="btn gray" id="prev"' + (s === 1 ? ' disabled' : '') + '>이전</button><button type="button" class="btn" id="next">' + (s === 4 ? '코스 적용' : '다음') + '</button></div>';
  P.innerHTML = h;
  wzBind();
  wzDraw();
}
function wzBind() {
  const q = (sel, fn) => document.querySelectorAll('#wizPanel ' + sel).forEach(fn);
  q('[data-rm]', b => b.onclick = () => { WZ.colors.splice(+b.dataset.rm, 1); wzComputeMask(); wzRender(); });
  if ($('tol')) { $('tol').oninput = e => { WZ.tol = +e.target.value; $('tolV').textContent = WZ.tol; clearTimeout(WZ._t); WZ._t = setTimeout(() => { wzComputeMask(); wzDraw(); }, 120); }; }
  if ($('showMask')) $('showMask').onchange = e => { WZ.showMask = e.target.checked; wzDraw(); };
  q('[data-mode]', b => b.onclick = () => { WZ.mode = b.dataset.mode; wzRender(); });
  q('[data-rmp]', b => b.onclick = () => { WZ.pts.splice(+b.dataset.rmp, 1); WZ.path = null; wzRender(); });
  q('[data-aimg]', b => b.onclick = () => { WZ.imgPick = +b.dataset.aimg; WZ.msg = ''; wzRender(); });
  q('[data-amap]', b => b.onclick = () => startMapPick(+b.dataset.amap));
  if ($('addAnchor')) $('addAnchor').onclick = () => { WZ.anchors.push({}); wzRender(); };
  if ($('preset')) $('preset').onchange = e => { if (e.target.value !== 'custom') { WZ.total = Number(e.target.value); $('totalIn').value = WZ.total; } };
  if ($('totalIn')) $('totalIn').oninput = e => { WZ.total = Number(e.target.value) || 0; const m = ['42.195', '21.0975', '10', '5'].find(v => Number(v) === WZ.total); $('preset').value = m || 'custom'; };
  $('prev').onclick = () => { WZ.step = Math.max(1, WZ.step - 1); WZ.msg = ''; wzRender(); };
  $('next').onclick = wzNext;
}
function wzNext() {
  WZ.msg = '';
  if (WZ.step === 1) {
    if (!WZ.colors.length) { WZ.msg = '코스선 위를 먼저 눌러 색을 알려 주세요.'; return wzRender(); }
    WZ.step = 2; if (!WZ.pts.length) WZ.mode = 'start'; return wzRender();
  }
  if (WZ.step === 2) {
    if (!WZ.pts.some(p => p.type === 'start') || !WZ.pts.some(p => p.type === 'end')) { WZ.msg = '시작점과 도착점을 모두 찍어 주세요.'; return wzRender(); }
    if (!wzEnsurePath()) return wzRender();
    WZ.step = 3; return wzRender();
  }
  if (WZ.step === 3) {
    if (!wzFitTransform(WZ.anchors)) { WZ.msg = '기준점을 2곳 이상 이미지와 지도 양쪽에서 선택해 주세요.'; return wzRender(); }
    WZ.step = 4; return wzRender();
  }
  wzApply();
}
function wzApply() {
  if (!(WZ.total >= 1)) { WZ.msg = '총 거리를 입력해 주세요.'; return wzRender(); }
  if (!wzEnsurePath()) { WZ.step = 2; return wzRender(); }
  const T = wzFitTransform(WZ.anchors); if (!T) { WZ.step = 3; WZ.msg = '기준점을 다시 선택해 주세요.'; return wzRender(); }
  const line = WZ.path.map(p => T.f(p[0], p[1]));
  const course = buildCustomCourse(line, WZ.total);
  const diff = Math.abs(course.lengthKm - WZ.total) / WZ.total * 100;
  wzClose(); renderCourse(course); setTop(true);
  if (diff > 12) alert('읽어 낸 코스선 길이는 약 ' + course.lengthKm.toFixed(1) + 'km로, 입력한 거리(' + WZ.total + 'km)와 ' + diff.toFixed(0) + '% 차이가 납니다. 기준점이 정확한지, 경유점(반환점)을 빠뜨리지 않았는지 확인해 주세요.');
}

// ----- 지도에서 기준점 고르기 -----
function startMapPick(i) {
  if (!theMap) { WZ.msg = '지도를 불러온 뒤에 사용할 수 있습니다.'; return wzRender(); }
  picking = { idx: i }; $('wiz').classList.add('away');
  $('pickText').textContent = '지도에서 기준점 ' + (i + 1) + '(이미지 ' + 'A' + (i + 1) + ')과 같은 장소를 눌러 주세요.';
  $('pickBanner').style.display = 'block'; setTop(false); setLegend(false); theMap.getCanvas().style.cursor = 'crosshair';
}
function endMapPick() { picking = null; $('pickBanner').style.display = 'none'; $('wiz').classList.remove('away'); if (theMap) theMap.getCanvas().style.cursor = ''; }
function finishMapPick(lngLat) {
  const i = picking.idx; WZ.anchors[i].ll = [lngLat.lng, lngLat.lat];
  const el = document.createElement('div'); el.className = 'anchorPin'; el.textContent = 'A' + (i + 1);
  WZ.anchorMarkers.push(new maplibregl.Marker({ element: el }).setLngLat([lngLat.lng, lngLat.lat]).addTo(theMap));
  endMapPick(); wzRender();
}
$('pickCancel').addEventListener('click', () => { endMapPick(); wzRender(); });

// ---------- 시작 ----------
if (typeof maplibregl === 'undefined') {
  showMsg('지도 라이브러리를 불러오지 못했습니다.<br>인터넷 연결을 확인한 뒤 새로고침해 주세요.<br>(표와 계산은 지도 없이도 동작합니다)');
  renderCourse(buildDefaultCourse());
} else {
  initMap();
}
</script>
</body>
</html>
